<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/font_black_0</item>
    </style>

    <style name="NoActionBarTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/font_black_0</item>
        <item name="colorControlNormal">@color/font_black_1</item>
        <item name="android:textColor">@color/font_black_1</item>
        <item name="android:windowContentTransitions" >true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <!-- Optionally, set your primary color as the status bar color -->
        <item name="android:statusBarColor">@color/font_black_0</item>
    </style>

    <style name="progressBarTheme" parent="@style/Theme.AppCompat">
        <item name="colorAccent">@color/colorPrimary</item>
    </style>

    <style name="Autocomplete">
        <item name="colorControlNormal">@color/font_black_0</item>
        <item name="colorControlActivated">@color/font_black_0</item>
    </style>

    <style name="MSV_ImageButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:paddingLeft">@dimen/search_icon_padding</item>
        <item name="android:paddingRight">@dimen/search_icon_padding</item>
    </style>

    <style name="SnapTimePicker" />

    <style name="SnapTimePicker.Title">
        <item name="android:textColor">@color/snap_time_picker_white</item>
        <item name="android:textSize">@dimen/snap_time_picker_text_size_large</item>
    </style>

    <style name="SnapTimePicker.Content">
        <item name="android:textColor">@color/snap_time_picker_black</item>
        <item name="android:textSize">@dimen/snap_time_picker_text_size_medium</item>
    </style>

    <style name="SnapTimePicker.Button">
        <item name="android:textColor">@color/snap_time_picker_default_primary</item>
        <item name="android:textSize">@dimen/snap_time_picker_text_size_medium</item>
        <item name="android:background">
            @drawable/snap_time_picker_selector_button_translucent_black_round
        </item>
        <item name="android:minWidth">@dimen/snap_time_picker_button_minimum_width</item>
        <item name="android:paddingEnd">@dimen/snap_time_picker_margin_padding_large</item>
        <item name="android:paddingStart">@dimen/snap_time_picker_margin_padding_large</item>
    </style>

    <style name="SnapTimePicker.HorizontalDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/snap_time_picker_divider_size</item>
        <item name="android:background">@color/snap_time_picker_extra_light_gray</item>
    </style>

    <style name="Widget.GoogleButton" parent="">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#3C4043</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:backgroundTint">@android:color/white</item>
        <item name="cornerRadius">8dp</item>
        <item name="strokeColor">#DADCE0</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Edit Contact admin form -->
    <style name="EditContactSection">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="EditContactField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:background">@drawable/bg_contact_card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">12dp</item>
    </style>

    <style name="EditContactLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/font_black_1</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="EditContactInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@null</item>
        <item name="android:textColor">@color/font_black_0</item>
        <item name="android:textColorHint">@color/font_black_4</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!--
      Reusable outlined input field (app-wide standard, replacing rengwuxian MaterialEditText).
      Usage: TextInputLayout style="@style/AppInputLayout" wrapping a
             TextInputEditText style="@style/AppInputEditText".
      Tweak corner radius / stroke / label color here once → every screen updates.
    -->
    <style name="AppInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
        <item name="boxStrokeColor">@color/til_box_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/colorPrimary</item>
        <item name="android:textColorHint">@color/font_black_3</item>
        <item name="hintAnimationEnabled">true</item>
    </style>

    <style name="AppInputEditText" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/font_black_0</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:drawableTint" tools:targetApi="23">@color/font_black_3</item>
    </style>
</resources>
