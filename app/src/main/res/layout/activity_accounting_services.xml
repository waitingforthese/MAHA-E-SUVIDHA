<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".LoginActivity"
    tools:ignore="MissingPrefix"
    android:background="@color/font_black_0"
    android:fitsSystemWindows="true">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"/>

    <include
            android:id="@+id/toolbar_layout"
            layout="@layout/toolbar" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_choose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/toolbar_layout"
        android:gravity="center"
        android:paddingTop="12dp"
        android:paddingBottom="10dp"
        android:text="@string/txt_choose_bill_type"
        android:textColor="@color/black_de"
        android:textSize="17sp"
        android:textStyle="bold" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/cvScanBill"
        android:layout_below="@+id/tv_choose">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp">

            <RadioGroup
                android:id="@+id/rgBillType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.appcompat.widget.AppCompatRadioButton
                    android:id="@+id/rbPurchases"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bill_type_bg_selector"
                    android:button="@null"
                    android:gravity="center"
                    android:text="Purchase"
                    android:textColor="@color/bill_type_text_selector" />

                <androidx.appcompat.widget.AppCompatRadioButton
                    android:id="@+id/rbSales"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bill_type_bg_selector"
                    android:button="@null"
                    android:gravity="center"
                    android:text="Sales"
                    android:textColor="@color/bill_type_text_selector" />

                <androidx.appcompat.widget.AppCompatRadioButton
                    android:id="@+id/rbExpenses"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bill_type_bg_selector"
                    android:button="@null"
                    android:gravity="center"
                    android:text="Loan Statement"
                    android:textColor="@color/bill_type_text_selector" />

                <androidx.appcompat.widget.AppCompatRadioButton
                    android:id="@+id/rbPayments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bill_type_bg_selector"
                    android:button="@null"
                    android:gravity="center"
                    android:text="Payments"
                    android:textColor="@color/bill_type_text_selector" />

                <androidx.appcompat.widget.AppCompatRadioButton
                    android:id="@+id/rbBankTransaction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bill_type_bg_selector"
                    android:button="@null"
                    android:gravity="center"
                    android:text="Bank Statement"
                    android:textColor="@color/bill_type_text_selector" />

                <androidx.appcompat.widget.AppCompatRadioButton
                    android:id="@+id/rbReceived"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bill_type_bg_selector"
                    android:button="@null"
                    android:gravity="center"
                    android:text="Receipt"
                    android:textColor="@color/bill_type_text_selector" />

                <androidx.appcompat.widget.AppCompatRadioButton
                    android:id="@+id/rbOther"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bill_type_bg_selector"
                    android:button="@null"
                    android:gravity="center"
                    android:text="Other"
                    android:textColor="@color/bill_type_text_selector" />
            </RadioGroup>
        </LinearLayout>
    </ScrollView>

    <androidx.cardview.widget.CardView
        android:id="@+id/cvScanBill"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        app:cardBackgroundColor="@color/white"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewBills"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginStart="24dp"
                android:layout_marginLeft="24dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="24dp"
                android:layout_marginRight="24dp"
                android:background="@color/colorPrimary"
                android:visibility="gone"
                android:text="View Bills"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:cornerRadius="20dp"
                app:strokeColor="@color/colorPrimary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScanBill"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginStart="24dp"
                android:layout_marginLeft="24dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="24dp"
                android:layout_marginRight="24dp"
                android:layout_marginBottom="12dp"
                android:background="@color/colorPrimary"
                android:enabled="false"
                android:text="Scan Bill"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:cornerRadius="20dp"
                app:strokeColor="@color/colorPrimary" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:theme="@style/progressBarTheme"
        android:visibility="gone"
        app:backgroundTint="@color/colorPrimary" />
</RelativeLayout>